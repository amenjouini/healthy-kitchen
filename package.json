{
  "name": "healthy-kitchen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/index.js",
    "dev:all": "node scripts/dev.js",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js --production",
    "lint": "eslint .",
    "test": "node --disable-warning=ExperimentalWarning --test \"shared/test/*.test.js\" \"server/test/*.test.js\"",
    "db:seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/scripts/seed.js",
    "db:seed:demo": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/scripts/seed.js --demo",
    "user:create": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/scripts/createUser.js",
    "preview": "vite preview",
    "i18n:check": "node scripts/i18n-extract.js --missing fr && node scripts/i18n-extract.js --missing ar"
  },
  "dependencies": {
    "@studio-freight/lenis": "^1.0.42",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.6",
    "react-intersection-observer": "^10.0.3",
    "react-parallax-mouse": "^2.1.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  },
  "engines": {
    "node": ">=22.13"
  }
}
