# Copy to .env (never commit .env). All values are optional in development.

# ─── Server ───────────────────────────────────────────────
PORT=8787
# HOST defaults to 127.0.0.1 in development and 0.0.0.0 in production (required on Render).
# HOST=127.0.0.1
# DATABASE_PATH=./data/healthy-kitchen.db
# UPLOADS_DIR=./data/uploads
# Public URL of the site — used in tracking links sent to customers and for CSRF origin checks.
PUBLIC_ORIGIN=http://localhost:5173
SESSION_DAYS=14
# Set to 1 when running behind a reverse proxy (nginx, Caddy) so rate limiting sees real client IPs.
TRUST_PROXY=0
# Seed the base catalogue automatically on start if the database has no meals (used on Render).
SEED_CATALOG_ON_START=0
# Tunisia = UTC+1 (minutes). Used for "today", daily reports and peak-hour analytics.
BUSINESS_UTC_OFFSET_MINUTES=60

# ─── First super admin (created on start if missing) ─────
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=change-me-to-a-long-password
# ADMIN_NAME=Owner

# ─── WhatsApp Cloud API (Meta) ────────────────────────────
# Leave WHATSAPP_PROVIDER empty to keep WhatsApp disabled (messages are recorded as "skipped").
WHATSAPP_PROVIDER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Development only: accept unsigned webhook calls to test the inbox locally. Refused in production.
WHATSAPP_ALLOW_UNSIGNED_DEV=0

# ─── Online payments ──────────────────────────────────────
# No gateway is integrated yet; while empty, customers can only choose cash.
PAYMENT_PROVIDER=

# ─── Demo data ───────────────────────────────────────────
# DEMO ONLY: on start, fill an EMPTY database (no orders) with demo accounts, stock and ~60 days of fake orders.
# Use on throw-away demo hosts only — never on a real production database.
SEED_DEMO_ON_START=0
# Password for the demo accounts (used by db:seed:demo and SEED_DEMO_ON_START)
# DEMO_PASSWORD=demo-password
